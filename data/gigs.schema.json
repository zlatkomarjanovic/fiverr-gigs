{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zlatkomarjanovic.github.io/fiverr-gigs/data/gigs.schema.json",
  "title": "Fiverr gig hub data",
  "type": "object",
  "required": ["seller", "sellerName", "sellerUrl", "updated", "gigs"],
  "properties": {
    "seller": { "type": "string", "minLength": 1 },
    "sellerName": { "type": "string", "minLength": 1 },
    "sellerUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.fiverr\\.com/" },
    "sellerSite": { "type": "string", "format": "uri", "pattern": "^https://" },
    "githubUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gigs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gig" }
    }
  },
  "$defs": {
    "faqItem": {
      "type": "object",
      "required": ["q", "a"],
      "properties": {
        "q": { "type": "string", "minLength": 1 },
        "a": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "gig": {
      "type": "object",
      "required": [
        "id", "slug", "url", "title", "shortTitle", "primaryKeyword", "lane",
        "searchTerms", "tags", "category", "subcategory", "summary", "description", "faq"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "slug": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://www\\.fiverr\\.com/" },
        "title": { "type": "string", "maxLength": 80 },
        "shortTitle": { "type": "string", "minLength": 1 },
        "primaryKeyword": { "type": "string", "minLength": 1 },
        "lane": { "type": "string", "minLength": 1 },
        "searchTerms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 500 },
        "faq": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/faqItem" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
